---
import { getNavItems, type NavActive, type NavContent } from '../lib/nav-content';

interface Props {
  content: NavContent;
  active: NavActive;
}
const { content: t, active } = Astro.props;
const items = getNavItems(t, active);
---

<nav>
  <a class="brand" href={t.lang === 'pl' ? '/' : '/en/'}>
    <svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true">
      <rect x="1" y="1" width="8" height="2.4" fill="#2f74f7"/><rect x="1" y="1" width="2.4" height="8" fill="#2f74f7"/>
      <rect x="17" y="1" width="8" height="2.4" fill="#f5a623"/><rect x="22.6" y="1" width="2.4" height="8" fill="#f5a623"/>
      <rect x="22.6" y="17" width="2.4" height="8" fill="#ff5a5f"/><rect x="17" y="22.6" width="8" height="2.4" fill="#ff5a5f"/>
      <rect x="1" y="17" width="2.4" height="8" fill="#57b894"/><rect x="1" y="22.6" width="8" height="2.4" fill="#57b894"/>
    </svg>
    <span class="brand-name">FunnyGuilds</span>
  </a>
  <div class="nav-right">
    <div class="tabs">
      {items.map((item) => (
        <a
          href={item.href}
          data-nav={item.key}
          class={item.active ? 'active' : ''}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
          aria-label={item.key === 'discord' ? item.label : undefined}
        >
          {item.key === 'discord' && (
            <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
            </svg>
          )}
          <span class="nav-label">{item.label}</span>
        </a>
      ))}
    </div>
    <div class="lang-switch">
      <a href={t.plHref} class={t.lang === 'pl' ? 'active' : ''}>PL</a>
      <span class="sep">/</span>
      <a href={t.enHref} class={t.lang === 'en' ? 'active' : ''}>EN</a>
    </div>
  </div>
</nav>

<style>
  nav { height: 58px; flex-shrink: 0; background: var(--paper); border-bottom: 1px solid var(--hairline); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; position: relative; z-index: 3; }
  .brand { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 15px; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; }
  .nav-right { display: flex; align-items: center; gap: 26px; }
  .tabs { display: flex; align-items: center; gap: 24px; font-size: 13.5px; font-weight: 500; }
  .tabs a { color: var(--slate); }
  .tabs a:hover { color: var(--ink); }
  .tabs a.active { color: var(--ink); font-weight: 600; }
  .lang-switch { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.02em; padding-left: 22px; border-left: 1px solid var(--hairline); }
  .lang-switch a { color: var(--slate-soft); }
  .lang-switch a:hover { color: var(--ink); }
  .lang-switch a.active { color: var(--blue); }
  .lang-switch .sep { color: var(--hairline-strong); }

  .nav-icon { display: none; width: 17px; height: 17px; }

  /* Everything stays on one row down to the smallest phones, which only fits by shedding what's
     redundant there: the home link (the logo already goes home) and the word "Discord" (the mark
     is recognisable on its own, and the label survives as the accessible name). */
  @media (max-width: 640px) {
    /* space-between runs out of slack at these widths, so the brand ends up touching the first
       link — the gap sets a floor on the spacing regardless. */
    nav { padding: 0 12px; gap: 12px; }
    .nav-right { gap: 10px; }
    .tabs { gap: 12px; font-size: 13px; }
    .tabs a[data-nav='home'] { display: none; }
    .tabs a[data-nav='discord'] { display: inline-flex; align-items: center; color: var(--slate); }
    .tabs a[data-nav='discord'] .nav-label { display: none; }
    .tabs a[data-nav='discord'] .nav-icon { display: block; }
    .tabs a[data-nav='discord']:hover { color: #5865f2; }
    .lang-switch { padding-left: 12px; }
  }

  @media (max-width: 360px) {
    nav { padding: 0 10px; gap: 10px; }
    .nav-right { gap: 8px; }
    .tabs { gap: 10px; font-size: 12.5px; }
    .brand { font-size: 14px; gap: 7px; }
    .lang-switch { padding-left: 9px; }
  }

  /* Below ~390px the wordmark, the Polish link labels and the language switcher stop fitting on
     one line together. The wordmark is the cheapest of the three to drop — the mark beside it
     still links home — and that keeps the nav one row down to the narrowest phones. */
  @media (max-width: 389px) {
    .brand-name { display: none; }
  }
</style>
