---
import { getNavItems, type NavActive, type NavContent } from '../lib/nav-content';

interface Props {
  content: NavContent;
  active: NavActive;
}
const { content: t, active } = Astro.props;
const items = getNavItems(t, active);
---

<nav>
  <a class="brand" href={t.lang === 'pl' ? '/' : '/en/'}>
    <svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true">
      <rect x="1" y="1" width="8" height="2.4" fill="#2f74f7"/><rect x="1" y="1" width="2.4" height="8" fill="#2f74f7"/>
      <rect x="17" y="1" width="8" height="2.4" fill="#f5a623"/><rect x="22.6" y="1" width="2.4" height="8" fill="#f5a623"/>
      <rect x="22.6" y="17" width="2.4" height="8" fill="#ff5a5f"/><rect x="17" y="22.6" width="8" height="2.4" fill="#ff5a5f"/>
      <rect x="1" y="17" width="2.4" height="8" fill="#57b894"/><rect x="1" y="22.6" width="8" height="2.4" fill="#57b894"/>
    </svg>
    FunnyGuilds
  </a>
  <div class="nav-right">
    <div class="tabs">
      {items.map((item) => (
        <a href={item.href} class={item.active ? 'active' : ''} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
          {item.label}
        </a>
      ))}
    </div>
    <div class="lang-switch">
      <a href={t.plHref} class={t.lang === 'pl' ? 'active' : ''}>PL</a>
      <span class="sep">/</span>
      <a href={t.enHref} class={t.lang === 'en' ? 'active' : ''}>EN</a>
    </div>
  </div>
</nav>

<style>
  nav { height: 58px; flex-shrink: 0; background: var(--paper); border-bottom: 1px solid var(--hairline); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; position: relative; z-index: 3; }
  .brand { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 15px; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; }
  .nav-right { display: flex; align-items: center; gap: 26px; }
  .tabs { display: flex; align-items: center; gap: 24px; font-size: 13.5px; font-weight: 500; }
  .tabs a { color: var(--slate); }
  .tabs a:hover { color: var(--ink); }
  .tabs a.active { color: var(--ink); font-weight: 600; }
  .lang-switch { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.02em; padding-left: 22px; border-left: 1px solid var(--hairline); }
  .lang-switch a { color: var(--slate-soft); }
  .lang-switch a:hover { color: var(--ink); }
  .lang-switch a.active { color: var(--blue); }
  .lang-switch .sep { color: var(--hairline-strong); }

  /* Below this the three groups stop fitting on one line, so the links wrap onto their own row
     rather than being hidden: unlike the docs pages, these pages have no drawer to fall back on,
     and hiding them left the landing page with no way to reach the documentation at all. */
  @media (max-width: 640px) {
    nav { height: auto; flex-wrap: wrap; padding: 10px 16px 11px; row-gap: 9px; }
    /* Ungroup .nav-right so brand and language sit on the first row and the links get the
       second one to themselves — keeping all three together overflowed at 320px. */
    .nav-right { display: contents; }
    .brand { order: 1; }
    .lang-switch { order: 2; margin-left: auto; padding-left: 0; border-left: none; }
    .tabs { order: 3; width: 100%; gap: 18px; font-size: 13px; }
  }
</style>
