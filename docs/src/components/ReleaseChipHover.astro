---
import type { McArchiveRelease } from '../lib/mc-version-archive';

interface Props {
  entry: McArchiveRelease;
}
const { entry } = Astro.props;

function snippetOf(html: string): string {
  const text = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  return text.length > 150 ? `${text.slice(0, 150)}…` : text;
}
const snippet = snippetOf(entry.changelogHtml);
---

<a class="release-chip chip-preview" href={entry.htmlUrl} target="_blank" rel="noopener" tabindex="0">
  {entry.tag}
  {entry.current && <span class="current-tag">current</span>}
  {entry.confidence === 'inferred' && <span class="inferred-tag">estimated</span>}
  <span class="preview-tooltip">
    {snippet}
    <em>View full release on GitHub ↗</em>
  </span>
</a>

<style>
  .release-chip {
    display: inline-flex; align-items: center; gap: 5px; font-family: var(--mono); font-size: 11.5px;
    color: var(--slate); background: #f5f6f8; padding: 4px 8px; border-radius: 4px; border: 1px solid transparent;
    position: relative; text-decoration: none;
  }
  .release-chip:hover { border-color: var(--blue); color: var(--blue); background: #fff; }
  .current-tag { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.03em; color: #fff; background: var(--green); padding: 1px 4px; border-radius: 2px; }
  .inferred-tag { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--slate-soft); border: 1px solid var(--hairline); border-radius: 2px; padding: 1px 4px; }

  .preview-tooltip {
    display: none; position: absolute; top: 100%; left: 0; margin-top: 6px; width: 280px; max-width: 80vw;
    background: #fff; border: 1px solid var(--hairline); border-radius: 8px; padding: 12px 14px;
    box-shadow: 0 12px 32px rgba(20, 23, 26, 0.16); z-index: 10; font-size: 0.78rem; line-height: 1.5; color: var(--slate);
  }
  .chip-preview:hover .preview-tooltip, .chip-preview:focus .preview-tooltip { display: block; }
  .preview-tooltip em { display: block; margin-top: 6px; color: var(--blue); font-style: normal; }
</style>
