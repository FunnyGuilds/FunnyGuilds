---
// Just the chip — the changelog it opens lives in the shared detail pane
// (ReleaseChangelogDetail.astro), rendered as a real second column of the same table rather
// than a popup. JS-driven (see Download.astro's script) rather than :target, so the active
// chip can be highlighted and the latest release pre-selected on load.
import { changelogId, type McArchiveRelease } from '../lib/mc-version-archive';

interface Props {
  entry: McArchiveRelease;
  currentLabel: string;
}
const { entry, currentLabel } = Astro.props;
---

<button class="release-chip" data-target={changelogId(entry.tag)} data-current={String(entry.current)}>
  {entry.tag}
  {entry.current && <span class="current-tag">{currentLabel}</span>}
</button>

<style>
  .release-chip {
    display: inline-flex; align-items: center; gap: 5px; font-family: var(--mono); font-size: 11.5px;
    color: var(--slate); background: #f5f6f8; padding: 4px 8px; border-radius: 4px; border: 1px solid transparent;
    cursor: pointer;
  }
  .release-chip:hover { border-color: var(--blue); color: var(--blue); background: #fff; }
  .release-chip.active { background: var(--blue); border-color: var(--blue); color: #fff; }
  .current-tag { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.03em; color: #fff; background: var(--green); padding: 1px 4px; border-radius: 2px; }
</style>
