---
import type { McArchiveRelease } from '../lib/mc-version-archive';

interface Props {
  entry: McArchiveRelease;
}
const { entry } = Astro.props;
const id = `v4-${entry.tag.replace(/[^a-zA-Z0-9]/g, '-')}`;
---

<button class="release-chip" popovertarget={id}>
  {entry.tag}
  {entry.current && <span class="current-tag">current</span>}
  {entry.confidence === 'inferred' && <span class="inferred-tag">estimated</span>}
</button>
<div popover id={id} class="drawer-panel">
  <div class="drawer-title">
    {entry.tag}
    <button class="drawer-close" popovertarget={id} popovertargetaction="hide">✕</button>
  </div>
  <div class="drawer-sub">Released {entry.dateLabel}</div>
  <div class="cl-body" set:html={entry.changelogHtml} />
</div>

<style>
  .release-chip {
    display: inline-flex; align-items: center; gap: 5px; font-family: var(--mono); font-size: 11.5px;
    color: var(--slate); background: #f5f6f8; padding: 4px 8px; border-radius: 4px; border: 1px solid transparent;
    cursor: pointer;
  }
  .release-chip:hover { border-color: var(--blue); color: var(--blue); background: #fff; }
  .current-tag { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.03em; color: #fff; background: var(--green); padding: 1px 4px; border-radius: 2px; }
  .inferred-tag { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--slate-soft); border: 1px solid var(--hairline); border-radius: 2px; padding: 1px 4px; }

  .drawer-panel {
    position: fixed; top: 0; right: 0; left: auto; bottom: 0; height: 100vh; width: min(420px, 92vw);
    max-width: none; max-height: none; margin: 0; border: none; border-radius: 0; padding: 22px 24px;
    box-shadow: -12px 0 40px rgba(20, 23, 26, 0.2); overflow-y: auto;
  }
  .drawer-panel::backdrop { background: rgba(20, 23, 26, 0.3); }
  .drawer-title { font-family: var(--mono); font-weight: 700; font-size: 1rem; margin-bottom: 4px; display: flex; justify-content: space-between; align-items: flex-start; }
  .drawer-sub { font-size: 0.78rem; color: var(--slate-soft); margin-bottom: 16px; }
  .drawer-close { font-family: var(--mono); font-size: 11px; color: var(--slate-soft); background: none; border: none; cursor: pointer; padding: 2px 6px; }
  .drawer-close:hover { color: var(--blue); }

  .cl-body { font-size: 0.84rem; line-height: 1.55; color: var(--slate); }
  .cl-body :global(p) { margin: 6px 0; }
  .cl-body :global(:first-child) { margin-top: 0; }
  .cl-body :global(h3), .cl-body :global(h4), .cl-body :global(h5), .cl-body :global(h6) { font-size: 0.88rem; font-weight: 700; color: var(--ink); margin: 12px 0 4px; }
  .cl-body :global(ul) { margin: 4px 0 8px 18px; padding: 0; }
  .cl-body :global(li) { margin: 2px 0; }
  .cl-body :global(a) { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
  .cl-body :global(code) { font-family: var(--mono); font-size: 0.85em; background: #eceef1; padding: 1px 4px; border-radius: 3px; }
  .cl-body :global(pre) { background: #14171a; color: #e2e5ea; padding: 10px 12px; border-radius: 6px; overflow-x: auto; font-size: 0.78rem; }
  .cl-body :global(pre code) { background: none; padding: 0; color: inherit; }
  .cl-body :global(strong) { color: var(--ink); }
  .cl-body :global(blockquote) { margin: 6px 0; padding-left: 10px; border-left: 2px solid var(--hairline-strong); color: var(--slate-soft); }
</style>
